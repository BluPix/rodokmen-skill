---
import Base from '../layouts/Base.astro';
import fan from '../generated/fan.svg?raw';
import { people } from '../lib/data.js';
const names = [...new Set(Object.values(people).filter((p) => p.direct && p.k > 1).map((p) => p.name))].sort((a, b) => a.localeCompare(b, 'cs'));
// kartička po najetí / klepnutí: celá data narození, sňatků a úmrtí (do políčka vějíře se vejdou nanejvýš roky)
const cards = Object.fromEntries(Object.values(people).filter((p) => p.direct)
  .map((p) => [p.slug, { name: p.name, rel: p.rel, years: p.years, life: p.life ?? [] }]));
---
<Base title="Vějíř předků" full>
  <div class="fan-bar">
    <strong>Vějíř předků</strong>
    <form class="fan-search" autocomplete="off">
      <input list="fan-names" placeholder="Najít předka…" aria-label="Najít předka" />
      <datalist id="fan-names">{names.map((n) => <option value={n} />)}</datalist>
      <button type="submit">Najít</button>
    </form>
    <span class="fan-btns">
      <button type="button" data-z="1.5" aria-label="Přiblížit">+</button>
      <button type="button" data-z="0.667" aria-label="Oddálit">−</button>
      <button type="button" data-z="0">Celý</button>
    </span>
    <span class="small muted fan-hint">Kolečkem myši přibližujte, tažením posouvejte, najetím na jméno uvidíte data, klepnutím otevřete stránku.</span>
  </div>
  <div class="fan-stage-wrap">
    <div class="fan-stage" set:html={fan} />
    <div class="fan-card" hidden>
      <button type="button" class="fan-card-close" aria-label="Zavřít">×</button>
      <strong class="fan-card-name"></strong><div class="small muted fan-card-rel"></div>
      <dl></dl>
      <a class="fan-card-link small" href="/">Otevřít stránku →</a>
    </div>
  </div>
  <script type="application/json" id="fan-cards" set:html={JSON.stringify(cards).replace(/</g, '\\u003c')} />

  <script>
    const stage = document.querySelector<HTMLElement>('.fan-stage')!;
    const svg = stage.querySelector('svg')!;
    const full = svg.viewBox.baseVal;
    const home = { x: full.x, y: full.y, w: full.width, h: full.height };
    let vb = { ...home };
    const apply = () => svg.setAttribute('viewBox', `${vb.x} ${vb.y} ${vb.w} ${vb.h}`);
    const toSvg = (cx: number, cy: number) => {
      const r = svg.getBoundingClientRect();
      const s = Math.max(vb.w / r.width, vb.h / r.height);
      const ox = (r.width * s - vb.w) / 2, oy = (r.height * s - vb.h) / 2;
      return { x: vb.x - ox + (cx - r.left) * s, y: vb.y - oy + (cy - r.top) * s, s };
    };
    const zoomAt = (f: number, cx?: number, cy?: number) => {
      const r = svg.getBoundingClientRect();
      const p = toSvg(cx ?? r.left + r.width / 2, cy ?? r.top + r.height / 2);
      const w = Math.min(home.w * 1.2, Math.max(home.w / 40, vb.w / f));
      const k = w / vb.w;
      vb = { x: p.x - (p.x - vb.x) * k, y: p.y - (p.y - vb.y) * k, w, h: vb.h * k };
      apply();
    };
    stage.addEventListener('wheel', (e) => { e.preventDefault(); zoomAt(e.deltaY < 0 ? 1.25 : 0.8, e.clientX, e.clientY); }, { passive: false });

    // drag to pan (mouse + one finger), pinch to zoom (two fingers)
    const pts = new Map<number, { x: number; y: number }>();
    let moved = 0, pinch = 0;
    stage.addEventListener('pointerdown', (e) => { pts.set(e.pointerId, { x: e.clientX, y: e.clientY }); moved = 0; });
    stage.addEventListener('pointermove', (e) => {
      const prev = pts.get(e.pointerId);
      if (!prev) return;
      pts.set(e.pointerId, { x: e.clientX, y: e.clientY });
      if (pts.size === 2) {
        const [a, b] = [...pts.values()];
        const d = Math.hypot(a.x - b.x, a.y - b.y);
        if (pinch) zoomAt(d / pinch, (a.x + b.x) / 2, (a.y + b.y) / 2);
        pinch = d; moved += 10;
        return;
      }
      const { s } = toSvg(e.clientX, e.clientY);
      const dx = e.clientX - prev.x, dy = e.clientY - prev.y;
      moved += Math.abs(dx) + Math.abs(dy);
      if (moved > 4) { stage.setPointerCapture(e.pointerId); vb.x -= dx * s; vb.y -= dy * s; apply(); }
    });
    const up = (e: PointerEvent) => { pts.delete(e.pointerId); if (pts.size < 2) pinch = 0; };
    stage.addEventListener('pointerup', up);
    stage.addEventListener('pointercancel', up);
    stage.addEventListener('click', (e) => { if (moved > 4) { e.preventDefault(); e.stopPropagation(); } }, true);

    // kartička: myší po najetí, dotykem první klepnutí ukáže kartičku a druhé otevře stránku
    const cards = JSON.parse(document.getElementById('fan-cards')!.textContent!);
    const card = document.querySelector<HTMLElement>('.fan-card')!;
    let shown = '', touch = false;
    const slugOf = (a: Element) => (a.getAttribute('href') ?? '').match(/\/osoba\/([^/]+)\//)?.[1] ?? '';
    const show = (slug: string) => {
      const c = cards[slug];
      if (!c) return;
      shown = slug;
      card.querySelector('.fan-card-name')!.textContent = c.name;
      card.querySelector('.fan-card-rel')!.textContent = c.rel;
      card.querySelector('dl')!.innerHTML = c.life.length
        ? c.life.map((u: { label: string; html: string }) => `<dt>${u.label}</dt><dd>${u.html}</dd>`).join('')
        : `<dd>${c.years || 'údaje zatím neznáme'}</dd>`;
      card.querySelector<HTMLAnchorElement>('.fan-card-link')!.href = `/osoba/${slug}/`;
      card.hidden = false;
    };
    stage.addEventListener('pointerdown', (e) => { touch = e.pointerType !== 'mouse'; }, true);
    svg.addEventListener('pointerover', (e) => {
      const a = (e.target as Element).closest('.fan-links a');
      if (a && e.pointerType === 'mouse') show(slugOf(a));
    });
    svg.addEventListener('click', (e) => {
      const a = (e.target as Element).closest('.fan-links a');
      if (a && touch && slugOf(a) !== shown) { e.preventDefault(); show(slugOf(a)); }
    });
    card.querySelector('.fan-card-close')!.addEventListener('click', () => { card.hidden = true; shown = ''; });

    document.querySelectorAll<HTMLButtonElement>('.fan-btns button').forEach((b) =>
      b.addEventListener('click', () => { const z = Number(b.dataset.z); if (z) zoomAt(z); else { vb = { ...home }; apply(); } })
    );

    // search: zoom to the ancestor's segment and highlight it
    const norm = (t: string) => t.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
    document.querySelector('.fan-search')!.addEventListener('submit', (e) => {
      e.preventDefault();
      const q = norm((e.currentTarget as HTMLFormElement).querySelector('input')!.value.trim());
      if (!q) return;
      svg.querySelectorAll('.fan-links a.hit').forEach((a) => a.classList.remove('hit'));
      const hits = [...svg.querySelectorAll<SVGAElement>('.fan-links a')].filter((a) => norm(a.querySelector('title')?.textContent ?? '').includes(q));
      if (!hits.length) return;
      hits.forEach((a) => a.classList.add('hit'));
      const bb = (hits[0].lastElementChild as SVGGraphicsElement).getBBox();
      const w = Math.max(bb.width, bb.height) * 7;
      vb = { x: bb.x + bb.width / 2 - w / 2, y: bb.y + bb.height / 2 - w / 2, w, h: w };
      apply();
    });
  </script>
</Base>
