---
import Base from '../../layouts/Base.astro';
import PersonLink from '../../components/PersonLink.astro';
import { records, recordList } from '../../lib/data.js';

export function getStaticPaths() {
  return recordList.map((r) => ({ params: { key: r.key } }));
}
const r = records[Astro.params.key];
const scanLabel = r.kind === 'J' ? (isNaN(Number(r.scan)) ? 'Evidenční kód' : 'Strana') : 'Snímek';
---
<Base title={r.title} wide>
  <p class="crumbs"><a href="/zapisy/">{r.kind === 'J' ? 'Zápisy a prameny' : 'Zápisy z matrik'}</a> · <span class="kind">{r.kindName}</span></p>
  <h1>{r.title}</h1>
  <p class="lead">{r.summary}</p>
  <div class="table-box"><table>
    <tbody>
      <tr><th>Datum</th><td>{r.date}</td></tr>
      <tr><th>{r.kind === 'J' ? 'Zdroj / instituce' : 'Archiv'}</th><td>{r.archive}</td></tr>
      <tr><th>{r.kind === 'J' ? 'Pramen' : 'Svazek'}</th><td>{r.volume}</td></tr>
      <tr><th>{scanLabel}</th><td>{r.scan}{r.url && <> – <a href={r.url} target="_blank" rel="noopener">otevřít na portálu {r.portal}</a></>}</td></tr>
      {r.people.length > 0 && <tr><th>Týká se</th><td>{r.people.map((s, i) => <>{i > 0 && ', '}<PersonLink slug={s} /></>)}</td></tr>}
    </tbody>
  </table></div>
  {r.img && (
    <p style="margin-top:1rem">
      <a href={r.full ? `/zdroje/${r.key}.jpg` : `/img/${r.key}.jpg`} target="_blank" rel="noopener"><span class="hl-wrap" style="border:1px solid var(--line);border-radius:8px"><img src={`/img/${r.key}.jpg`} alt={`Výřez: ${r.title}`} />{r.boxes.map(([x0, y0, x1, y1]) => <span class="hl" style={`left:${x0 * 100}%;top:${y0 * 100}%;width:${(x1 - x0) * 100}%;height:${(y1 - y0) * 100}%`}></span>)}</span></a>
      <br /><span class="small muted">{r.boxes.length ? 'Zvýrazněné je označené místo, ze kterého čteme. ' : ''}{r.full ? 'Kliknutím otevřete výřez v plném rozlišení.' : ''}</span>
    </p>
  )}
  {r.orig && (
    <div class="transcript">
      <div class="tr-grid">
        <div><h2>Přepis originálu</h2><p class="tr-orig">{r.orig}</p></div>
        <div><h2>{r.kind === 'J' ? 'Překlad / vysvětlení' : 'Překlad'}</h2><p class="tr-cs">{r.cs}</p></div>
      </div>
      <p class="small muted">Nejistá čtení jsou označená (?), nečitelná místa […]. Přepis si můžete ověřit na výřezu výše.</p>
    </div>
  )}
</Base>
